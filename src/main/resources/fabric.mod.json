{
	"schemaVersion": 1,
	"id": "simpleores",
	"version": "${version}",
	"name": "SimpleOres Refabricated",
	"description": "An unofficial port of SimpleOres for fabric",
	"authors": [
		"Paulem"
	],
	"contact": {
		"homepage": "https://paulem.ovh",
		"sources": "https://github.com/Paulem79/SimpleOres-fabric",
		"issues": "https://github.com/Paulem79/SimpleOres-fabric/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/simpleores/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "ovh.paulem.simpleores.SimpleOres"
		],
		"modmenu": [
          "ovh.paulem.simpleores.config.ModMenuCompat"
		],
		"client": [
          "ovh.paulem.simpleores.SimpleOresClient"
		],
		"fabric-datagen": [
			"ovh.paulem.simpleores.datagen.SimpleOresDataGenerator"
		]
	},
	"mixins": [
		"simpleores.mixins.json"
	],
	"depends": {
		"java": "*",
		"minecraft": ">=${min_version_range} <=${max_version_range}",
		"fabricloader": "*",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"recommends": {
		"modmenu": "*",
		"energizedpower": "*"
	}
}