{
	"schemaVersion": 1,
	"id": "simpleores",
	"version": "${version}",
	"name": "SimpleOres Fabric",
	"description": "An unofficial port of SimpleOres for fabric",
	"authors": [
		"Paulem"
	],
	"contact": {
		"homepage": "https://paulem.net",
		"sources": "https://github.com/Paulem79/SimpleOres-fabric",
		"issues": "https://github.com/Paulem79/SimpleOres-fabric/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/simpleores/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "net.paulem.simpleores.SimpleOres"
		],
		"modmenu": [
          "net.paulem.simpleores.config.ModMenuCompat"
		],
		"client": [
          "net.paulem.simpleores.SimpleOresClient"
		],
		"fabric-datagen": [
			"net.paulem.simpleores.datagen.SimpleOresDataGenerator"
		]
	},
	"mixins": [
      "simpleores.mixins.json${client_mixin_expansion}"
	],
    "accessWidener" : "accesswideners/${aw_file}",
	"depends": {
		"java": "*",
		"minecraft": ">=${min_version_range} <=${max_version_range}",
		"fabricloader": "${fabricloader_version}",
		"fabric-api": "*${bucketlib_expansion}"
	},
	"breaks": {
		"fabric-api": "${fabric_api_breaks_version}"
	},
	"recommends": {
		"cloth-config": "*",
		"modmenu": "*",
		"energizedpower": "*"
	}
}
